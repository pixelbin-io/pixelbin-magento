<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="catalog_product_save_after">
        <observer name="pixel_after_catalog_product_save" instance="Pixelbinio\Pixelbin\Observer\ProductSaveAfter" />
    </event>
    <event name="catalog_category_save_after">
        <observer name="pixel_after_catalog_category_save" instance="Pixelbinio\Pixelbin\Observer\CategorySaveAfter"/>
