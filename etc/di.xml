    <type name="Magento\MediaStorage\App\Media">
        <plugin name="pixelbin-web-images-media-plugin" type="Pixelbinio\Pixelbin\Plugin\App\MediaPlugin" />
    </type>
    <type name="Magento\MediaStorage\Model\File\Validator\NotProtectedExtension">
        <plugin name="pixelbin-allow-web-images" type="Pixelbinio\Pixelbin\Plugin\File\Validator\NotProtectedExtensionPlugin" />
    </type>
    <type name="Magento\Cms\Model\Wysiwyg\Images\Storage">
        <plugin name="pixelbin-allow-web-images" type="Pixelbinio\Pixelbin\Plugin\Wysiwyg\Images\StoragePlugin" />
    </type>
    <type name="Magento\Cms\Controller\Adminhtml\Wysiwyg\Images\Thumbnail">
        <plugin name="pixelbinallow-web-images" type="Pixelbinio\Pixelbin\Plugin\Controller\Adminhtml\Wysiwyg\Images\ThumbnailPlugin" />
    </type>
    <type name="Magento\Cms\Controller\Adminhtml\Wysiwyg\Directive">
        <plugin name="allow-web-images" type="Pixelbinio\Pixelbin\Plugin\Controller\Adminhtml\Wysiwyg\DirectivePlugin" />
    </type>
    <type name="Magento\MediaGallerySynchronization\Model\CreateAssetFromFile">
        <arguments>
            <argument name="assetFactory" xsi:type="object">Pixelbinio\Pixelbin\Model\AssetFactory</argument>
        </arguments>
    </type>
    <type name="Magento\PageBuilder\Controller\Adminhtml\ContentType\Image\Upload">
        <arguments>
            <argument name="uploaderFactory" xsi:type="object">Pixelbinio\Pixelbin\Model\File\UploaderFactory</argument>
        </arguments>
    </type>
