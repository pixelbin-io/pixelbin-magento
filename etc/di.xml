<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!--  For console command  -->
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="pixelbin_upload_all" xsi:type="object">Pixelbinio\Pixelbin\Console\UploadImageToPixelBin</item>
            </argument>
        </arguments>
    </type>

    <!--  For images logs grid  -->
     <virtualType name="Pixelbinio\Pixelbin\Model\ResourceModel\PixelbinSynchronisation\Grid\Collection"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">pixelbin_synchronisation</argument>
            <argument name="resourceModel" xsi:type="string">Pixelbinio\Pixelbin\Model\ResourceModel\PixelbinSynchronisation</argument>
        </arguments>
    </virtualType>
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="pixelbin_images_data_list_data_source" xsi:type="string">
                    Pixelbinio\Pixelbin\Model\ResourceModel\PixelbinSynchronisation\Grid\Collection
                </item>
            </argument>
        </arguments>
    </type>

    <!-- Custom logger for this extension it will generate pixelbin.log file in /var/log/ -->
    <type name="Pixelbinio\Pixelbin\Logger\Handler">
        <arguments>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
        </arguments>
    </type>
    <type name="Pixelbinio\Pixelbin\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">PixelbinLogger</argument>
            <argument name="handlers"  xsi:type="array">
                <item name="system" xsi:type="object">Pixelbinio\Pixelbin\Logger\Handler</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\MediaStorage\Model\File\Uploader">
        <plugin name="pixelbin_file_uploader_plugin" type="Pixelbinio\Pixelbin\Model\MediaStorage\File\Uploader"/>
    </type>
    <type name="Magento\Framework\File\Uploader">
        <plugin name="pixelbin_framework_file_uploader_plugin" type="Pixelbinio\Pixelbin\Model\MediaStorage\Framework\Uploader"/>
    </type>
    <preference for="Pixelbinio\Pixelbin\Api\ResourcesManagementInterface" type="Pixelbinio\Pixelbin\Model\Repository\ResourcesManagement"/>
    <type name="Magento\Cms\Model\Wysiwyg\Images\Storage">
        <arguments>
            <argument name="extensions" xsi:type="array">
                <item name="allowed" xsi:type="array">
                    <item name="svg" xsi:type="string">image/svg</item>
                    <item name="svg-xml" xsi:type="string">image/svg+xml</item>
                    <item name="webp" xsi:type="string">image/webp</item>
                    <item name="tiff" xsi:type="string">image/tiff</item>
                    <item name="avif" xsi:type="string">image/avif</item>
                    <item name="heic" xsi:type="string">image/heic</item>
                    <item name="heif" xsi:type="string">image/heif</item>
                    <item name="raw" xsi:type="string">image/raw</item>
                    <item name="cr2" xsi:type="string">image/cr2</item>
                    <item name="nef" xsi:type="string">image/nef</item>
                    <item name="rw2" xsi:type="string">image/rw2</item>
                    <item name="dng" xsi:type="string">image/dng</item>
                    <item name="orf" xsi:type="string">image/orf</item>
