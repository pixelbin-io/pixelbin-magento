<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <type name="Magento\Catalog\Block\Product\Image">
        <plugin name="after_get_image_url_plugin" type="Pixelbinio\Pixelbin\Plugin\AfterGetImageUrl"/>
    </type>

    <type name="Magento\Catalog\Model\Product\Image\UrlBuilder">
        <plugin name="pixelbin_plugin_catalog_model_product_image_urlbuilder" type="Pixelbinio\Pixelbin\Plugin\Catalog\Model\Product\Image\UrlBuilder"/>
    </type>

    <type name="Magento\Catalog\Block\Product\ImageFactory">
        <plugin name="pixelbin_plugin_catalog_block_product_imagefactory" type="Pixelbinio\Pixelbin\Plugin\Catalog\Block\Product\ImageFactory"/>
    </type>

    <type name="Magento\Checkout\CustomerData\AbstractItem">
        <plugin name="minicart_after_get_itemdata_plugin" type="Pixelbinio\Pixelbin\Plugin\Minicart\AfterGetItemData" sortOrder="1"/>
    </type>

    <type name="Magento\Catalog\Model\View\Asset\Placeholder">
        <plugin name="placeholder_image_change" type="Pixelbinio\Pixelbin\Plugin\AfterPlaceholderLoad" sortOrder="110"/>
    </type>

    <type name="Magento\Cms\Block\Block">
        <plugin name="pixelbin_plugin_block_cms_block_block" type="Pixelbinio\Pixelbin\Plugin\Cms\Block\Block"/>
    </type>

    <type name="Magento\Cms\Block\Widget\Block">
        <plugin name="pixelbin_plugin_block_cms_block_widget_block" type="Pixelbinio\Pixelbin\Plugin\Cms\Block\Widget\Block"/>
    </type>

    <type name="Magento\Catalog\Block\Category\View">
        <plugin name="pixelbin_plugin_block_catalog_category_view" type="Pixelbinio\Pixelbin\Plugin\Catalog\Block\Category\View"/>
    </type>

    <type name="Magento\Catalog\Model\Category\Image">
        <plugin name="after_get_image_url_category" type="Pixelbinio\Pixelbin\Plugin\Catalog\Model\Category\AfterGetCategoryImage" />
    </type>

    <type name="Magento\Widget\Model\Template\Filter">
        <plugin name="pixelbin_plugin_widget_model_template_filter" type="Pixelbinio\Pixelbin\Plugin\Widget\Model\Template\Filter"/>
    </type>

</config>