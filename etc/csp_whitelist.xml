<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp/etc/csp_whitelist.xsd">
    <policies>
        <policy id="script-src">
            <values>
                <value id="pixelbin_main" type="host">jsdelivr.net</value>
                <value id="pixelbin_wildcard" type="host">*.jsdelivr.net</value>
                <value id="pixelbin_cloudflare_cdnjs" type="host">cdnjs.cloudflare.com</value>
                <value id="youtube_scripts" type="host">*.youtube.com</value>
                <value id="vimeo_scripts" type="host">*.vimeo.com</value>
                <value id="cld_video_player_script" type="host" >unpkg.com</value>
            </values>
        </policy>
        <policy id="frame-src">
            <values>
                <value id="pixelbin_main" type="host">jsdelivr.net</value>
                <value id="pixelbin_wildcard" type="host">*.jsdelivr.net</value>
                <value id="pixelbin_cloudflare_cdnjs" type="host">cdnjs.cloudflare.com</value>
            </values>
        </policy>
        <policy id="connect-src">
            <values>
                <value id="pixelbin_main" type="host">jsdelivr.net</value>
                <value id="pixelbin_wildcard" type="host">*.jsdelivr.net</value>
            </values>
        </policy>
        <policy id="form-action">
            <values>
                <value id="pixelbin_main" type="host">jsdelivr.net</value>
                <value id="pixelbin_wildcard" type="host">*.jsdelivr.net</value>
            </values>
        </policy>
        <policy id="img-src">
            <values>
                <value id="pixelbin_main" type="host">jsdelivr.net</value>
                <value id="pixelbin_wildcard" type="host">*.jsdelivr.net</value>
                <value id="data" type="host">data:</value>
            </values>
        </policy>
        <policy id="style-src">
            <values>
                <value id="pixelbin_main" type="host">jsdelivr.net</value>
                <value id="pixelbin_wildcard" type="host">*.jsdelivr.net</value>
                <value id="google_wildcard" type="host">*.googleapis.com</value>
                <value id="cld_video_player_css" type="host" >unpkg.com</value>
            </values>
        </policy>
        <policy id="media-src">
            <values>
                <value id="pixelbin_main" type="host">jsdelivr.net</value>
                <value id="pixelbin_wildcard" type="host">*.jsdelivr.net</value>
            </values>
        </policy>
        <policy id="font-src">
            <values>
                <value id="google_wildcard" type="host">*.gstatic.com</value>
                <value id="pixelbin_wildcard" type="host">*.jsdelivr.net</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
