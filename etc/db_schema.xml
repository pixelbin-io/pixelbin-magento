<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="pixelbin_synchronisation" resource="default" engine="innodb" comment="Pixelbin Synchronisation">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" padding="10" identity="true"
                comment="Entity Id"/>
        <column xsi:type="varchar" length="255" name="image_path" default="null" comment="Image Path"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
    </table>
    <table name="pixelbin_image_sync_logs" resource="default" engine="innodb" comment="Pixelbin Synchronisation">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" padding="10" identity="true"
                comment="Entity Id"/>
        <column xsi:type="varchar" length="255" name="request" default="null" comment="Request"/>
        <column xsi:type="varchar" length="255" name="response" default="null" comment="Response"/>
        <column xsi:type="varchar" length="255" name="sync_type" default="null" comment="Sync Type"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP"
                comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
    </table>
</schema>
